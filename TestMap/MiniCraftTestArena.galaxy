bool MCT_Start(bool testConds,bool runActions) {
    int p = 2;
    int q;
    point lo = RegionGetBoundsMin(RegionPlayableMap());
    point hi = RegionGetBoundsMax(RegionPlayableMap());
    point at;
    fixed ox = PointGetX(lo);
    fixed oy = PointGetY(lo);
    fixed w = PointGetX(hi)-ox;
    fixed h = PointGetY(hi)-oy;
    if (!runActions || mct_started) { return true; }
    mct_started = true;
    if (w < 176.0 || h < 176.0 || PlayerType(1) != c_playerTypeUser) {
        MCT_Log("Need flat playable area >=176x176 and P1 user.");
        return true;
    }
    while (p <= 4) {
        if (PlayerType(p) != c_playerTypeComputer || PlayerStatus(p) != c_playerStatusActive) {
            MCT_Log("P2-P4 must be active computer slots."); return true;
        }
        at = PlayerStartLocation(p);
        if (at == null || PointGetY(at) < oy+110.0 || PointGetY(at) > oy+h-14.0 || PointGetX(at) < ox+14.0 || PointGetX(at) > ox+w-14.0) {
            MCT_Log("Place P2-P4 start locations across the north, away from edges."); return true;
        }
        p += 1;
    }
    PlayerSetRace(2,"Terr");
    PlayerSetRace(3,"Zerg");
    PlayerSetRace(4,"Prot");
    MeleeInitOptions();
    p = 2;
    while (p <= 4) {
        libNtve_gf_SetAlliance(1,p,libNtve_ge_AllianceSetting_Enemy);
        q = p+1;
        while (q <= 4) {
            libNtve_gf_SetAlliance(p,q,libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
            q += 1;
        }
        p += 1;
    }
    MCT_Bank(ox+30.0,oy+25.0,false);
    MCT_Bank(ox+88.0,oy+25.0,false);
    MCT_Bank(ox+146.0,oy+25.0,false);
    MCT_Create("CommandCenter",1,ox+30.0,oy+25.0,1);
    MCT_Create("Hatchery",1,ox+88.0,oy+25.0,1);
    MCT_Create("Nexus",1,ox+146.0,oy+25.0,1);
    MCT_Create("SCV",1,ox+30.0,oy+29.0,12);
    MCT_Create("Drone",1,ox+88.0,oy+29.0,12);
    MCT_Create("Probe",1,ox+146.0,oy+29.0,12);
    MCT_Create("Refinery",1,ox+21.0,oy+23.0,1);
    MCT_Create("Extractor",1,ox+79.0,oy+23.0,1);
    MCT_Create("Assimilator",1,ox+137.0,oy+23.0,1);
    MCT_Money(1);
    PlayerModifyPropertyInt(1,c_playerPropSuppliesLimit,c_playerPropOperSetTo,500);
    MCT_Gallery(ox,oy);
    p = 2;
    while (p <= 4) {
        at = PlayerStartLocation(p);
        MCT_Bank(PointGetX(at),PointGetY(at),true);
        MeleeInitUnitsForPlayer(p,PlayerRace(p),at);
        MCT_Money(p);
        PlayerSetDifficulty(p,7);
        p += 1;
    }
    MeleeInitAI();
    MCT_Log("Ready: 3 race gallery / 1v3 alliance. Created calls="+IntToString(mct_created)+" skipped="+IntToString(mct_skipped));
    return true;
}
void MCT_Init() {
    trigger t = TriggerCreate("MCT_Start");
    TriggerAddEventTimeElapsed(t,0.1,c_timeGame);
}
