// MiniCraft Test Arena - paste into a map custom script, InitFunc MCT_Init.
// Private test only. No melee initialization trigger in the map.
// Start locations: P1 south, P2-P4 north. Use a 192x192 flat map.
bool mct_started = false;
int mct_created = 0;
int mct_skipped = 0;
void MCT_Log(string s) {
    UIDisplayMessage(PlayerGroupAll(),c_messageAreaChat,StringToText("[MiniCraft Test] "+s));
    TriggerDebugOutput(1,StringToText("[MiniCraft Test] "+s),true);
}
unit MCT_Create(string id,int p,fixed x,fixed y,int count) {
    unit u;
    if (!CatalogEntryIsValid(c_gameCatalogUnit,id)) {
        mct_skipped += 1;
        MCT_Log("missing "+id);
        return null;
    }
    UnitCreate(count,id,0,p,Point(x,y),270.0);
    u = UnitLastCreated();
    if (u == null || UnitGetType(u) != id || UnitGetOwner(u) != p) {
        mct_skipped += 1;
        MCT_Log("creation unconfirmed "+id);
        return null;
    }
    mct_created += 1;
    return u;
}
void MCT_Resource(string id,fixed x,fixed y) {
    unit u = MCT_Create(id,0,x,y,1);
    if (u != null) { UnitSetPropertyFixed(u,c_unitPropResources,100000.0); }
}
void MCT_Bank(fixed x,fixed y,bool north) {
    int i = 0;
    fixed direction = 1.0;
    if (!north) { direction = -1.0; }
    while (i < 10) {
        MCT_Resource("MineralField",x-9.0+IntToFixed(i)*2.0,y+direction*7.0);
        i += 1;
    }
    MCT_Resource("VespeneGeyser",x-9.0,y+direction*2.0);
    MCT_Resource("VespeneGeyser",x+9.0,y+direction*2.0);
}
void MCT_Money(int p) {
    PlayerModifyPropertyInt(p,c_playerPropMinerals,c_playerPropOperSetTo,10000);
    PlayerModifyPropertyInt(p,c_playerPropVespene,c_playerPropOperSetTo,10000);
}
