    mc_foodId[68] = "RavagerCocoon"; mc_foodBase[68] = -1;
    mc_foodId[69] = "BanelingCocoon"; mc_foodBase[69] = -0.25;
    mc_foodId[70] = "BroodLordCocoon"; mc_foodBase[70] = -1;
    mc_foodId[71] = "ObserverSiegeMode"; mc_foodBase[71] = -0.5;
}
fixed MC_TargetFood(int i, int n, bool freeWorkers) {
    if (freeWorkers && MC_Worker(mc_foodId[i])) { return 0.0; }
    return mc_foodBase[i] / IntToFixed(n);
}
bool MC_SetFood(int n, bool freeWorkers) {
    int p = 1;
    int i;
    fixed desired;
    fixed observed;
    bool ok = true;
    while (p <= 15) {
        if (MC_Active(p)) {
            i = 0;
            while (i < 72) {
                desired = MC_TargetFood(i,n,freeWorkers);
                if (desired != mc_foodBase[i]) {
                    if (!CatalogFieldValueSet(c_gameCatalogUnit,mc_foodId[i],"Food",p,FixedToString(desired,c_fixedPrecisionAny))) { ok = false; }
                    observed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit,mc_foodId[i],"Food",p));
                    if (observed != desired) { ok = false; }
                }
                i += 1;
            }
        }
        p += 1;
    }
    if (!ok) {
        // Restore all changed food entries; never activate duplicate spawning on a failed catalog transaction.
        p = 1;
        while (p <= 15) {
            if (MC_Active(p)) {
                i = 0;
                while (i < 72) {
                    if (MC_TargetFood(i,n,freeWorkers) != mc_foodBase[i]) {
                        if (!CatalogFieldValueSet(c_gameCatalogUnit,mc_foodId[i],"Food",p,FixedToString(mc_foodBase[i],c_fixedPrecisionAny))) {
                            TriggerDebugOutput(1,StringToText("MiniCraft Food rollback failed: "+mc_foodId[i]),true);
                        }
                    }
                    i += 1;
                }
            }
            p += 1;
        }
    }
    return ok;
}
bool MC_TrainAbility(string a) {
    return a == "CommandCenterTrain" || a == "BarracksTrain" || a == "FactoryTrain" || a == "StarportTrain" || a == "NexusTrain" || a == "GatewayTrain" || a == "StargateTrain" || a == "RoboticsFacilityTrain" || a == "LarvaTrain" || a == "WarpGateTrain" || a == "TrainQueen";
}
bool MC_TrainUnit(string id) {
    return id == "SCV" || id == "Marine" || id == "Marauder" || id == "Reaper" || id == "Ghost" || id == "Hellion" || id == "WidowMine" || id == "SiegeTank" || id == "Cyclone" || id == "Thor" || id == "VikingFighter" || id == "Medivac" || id == "Liberator" || id == "Raven" || id == "Banshee" || id == "Battlecruiser" || id == "Drone" || id == "Zergling" || id == "Roach" || id == "Hydralisk" || id == "Infestor" || id == "SwarmHostMP" || id == "Ultralisk" || id == "Queen" || id == "Mutalisk" || id == "Corruptor" || id == "Viper" || id == "Probe" || id == "Zealot" || id == "Stalker" || id == "Sentry" || id == "Adept" || id == "HighTemplar" || id == "DarkTemplar" || id == "Immortal" || id == "Colossus" || id == "Disruptor" || id == "Observer" || id == "WarpPrism" || id == "Phoenix" || id == "VoidRay" || id == "Oracle" || id == "Tempest" || id == "Carrier";
}
bool MC_OnTrain(bool testConds,bool runActions) {
    unit u;
    int p;
    int i = 0;
    string id;
    fixed actual;
    if (!runActions || !mc_configured || mc_mult <= 1) { return true; }
    if (!MC_TrainAbility(EventUnitCreatedAbil())) { return true; }
    u = EventUnitCreatedUnit();
    if (u == null || !UnitIsAlive(u)) { return true; }
    p = UnitGetOwner(u);
    id = UnitGetType(u);
    if (!MC_Active(p) || !MC_TrainUnit(id)) { return true; }
    // Verify actual unit food, not only the catalog readback.
    while (i < 72) {
        if (mc_foodId[i] == id) { break; }
        i += 1;
    }
    if (i >= 72) { return true; }
    actual = UnitGetPropertyFixed(u,c_unitPropSuppliesUsed,c_unitPropCurrent);
    if (actual != -MC_TargetFood(i,mc_mult,mc_workersFree)) {
        TriggerDebugOutput(1,StringToText("MiniCraft: actual supply differs; batch skipped for "+id),true);
        return true;
    }
    // Script-created copies have no training ability and cannot trigger another batch.
    // Each native Zergling birth is handled once (two births per normal egg).
    UnitCreate(mc_mult-1,id,0,p,UnitGetPosition(u),UnitGetFacing(u));
    return true;
}
string MC_RichType(string id) {
    if (id == "MineralField" || id == "PurifierMineralField" || id == "LabMineralField" || id == "BattleStationMineralField" || id == "MineralFieldOpaque") { return "RichMineralField"; }
    if (id == "MineralField750" || id == "MineralField450" || id == "PurifierMineralField750" || id == "LabMineralField750" || id == "BattleStationMineralField750" || id == "MineralField900Opaque") { return "RichMineralField750"; }
    if (id == "VespeneGeyser" || id == "SpacePlatformGeyser" || id == "ProtossVespeneGeyser" || id == "PurifierVespeneGeyser" || id == "ShakurasVespeneGeyser") { return "RichVespeneGeyser"; }
    return "";
}
bool MC_IsRich(string id) {
    return id == "RichMineralField" || id == "RichMineralField750" || id == "PurifierRichMineralField" || id == "PurifierRichMineralField750" || id == "RichVespeneGeyser";
}
void MC_Resources(int percent, bool rich) {
    unitgroup g = UnitGroup(null,c_playerAny,RegionEntireMap(),null,0);
    int i = UnitGroupCount(g,c_unitCountAll);
    unit u;
    string id;
    string target;
    fixed amount;
    while (i > 0) {
        u = UnitGroupUnit(g,i);
        i -= 1;
        if (u != null && UnitIsAlive(u)) {
            id = UnitGetType(u);
            target = MC_RichType(id);
            if (target != "" || MC_IsRich(id)) {
                amount = UnitGetPropertyFixed(u,c_unitPropResources,c_unitPropCurrent);
                if (amount > 0.0) {
                    if (rich && target != "") {
                        libNtve_gf_ReplaceUnit(u,target,libNtve_ge_ReplaceUnitOptions_NewUnitsDefault);
                        u = libNtve_gf_LastReplacedUnit();
                    }
                    if (u != null) { UnitSetPropertyFixed(u,c_unitPropResources,amount * (IntToFixed(percent) / 100.0)); }
                }
            }
        }
    }
}
string MC_Value(int row) {
    int v = mc_choice[row];
    if (row == 0) { return "미니 (일반 모드 준비 중)"; }
    if (row == 1) { return IntToString(v+1)+"배"; }
    if (row == 2) { if (v == 0) { return "미강화"; } return "강화"; }
    if (row == 3) { return IntToString(200+100*v); }
    if (row == 4) {
        if (v == 0) { return "100%"; }
        if (v == 1) { return "150%"; }
        if (v == 2) { return "200%"; }
        if (v == 3) { return "300%"; }
        if (v == 4) { return "500%"; }
        if (v == 5) { return "꿀광·꿀가스 100%"; }
        if (v == 6) { return "꿀광·꿀가스 150%"; }
        if (v == 7) { return "꿀광·꿀가스 200%"; }
        if (v == 8) { return "꿀광·꿀가스 300%"; }
        return "꿀광·꿀가스 500%";
    }
    if (v == 0) { return "일꾼 인구 포함"; }
    return "일꾼 인구 미포함";
}
int MC_Button(string title,int x,int y,int w) {
    int c = DialogControlCreate(mc_dialog,c_triggerControlTypeButton);
    DialogControlSetSize(c,PlayerGroupAll(),w,46);
    DialogControlSetPosition(c,PlayerGroupAll(),c_anchorTopLeft,x,y);
    DialogControlSetPropertyAsText(c,c_triggerControlPropertyText,PlayerGroupAll(),StringToText(title));
    return c;
}
void MC_Apply() {
    int p = 1;
    int pct = 100;
    int v = mc_choice[4];
    bool rich = v >= 5;
    if (mc_configured) { return; }
    // Release the setup pause before any experimental native calls, so an engine error cannot leave the game frozen.
    UnitPauseAll(false);
    AITimePause(false);
    if (mc_dialog != -1) { DialogDestroy(mc_dialog); mc_dialog = -1; }
    mc_mult = mc_choice[1]+1;
    mc_workersFree = mc_choice[5] == 1;
    if (!MC_SetFood(mc_mult,mc_workersFree)) {
        mc_mult = 1;
        mc_workersFree = false;
        TriggerDebugOutput(1,StringToText("MiniCraft: Food catalog change rejected; production multiplier and worker exemption disabled."),true);
    }
    while (p <= 15) {
        if (MC_Active(p)) { PlayerModifyPropertyInt(p,c_playerPropSuppliesLimit,c_playerPropOperSetTo,200+100*mc_choice[3]); }
        p += 1;
    }
    if (rich) { v -= 5; }
    if (v == 1) { pct = 150; }
    if (v == 2) { pct = 200; }
    if (v == 3) { pct = 300; }
    if (v == 4) { pct = 500; }
    if (pct != 100 || rich) { MC_Resources(pct,rich); }
    if (mc_mult > 1) {
        mc_spawnTrigger = TriggerCreate("MC_OnTrain");
        TriggerAddEventUnitCreated(mc_spawnTrigger,null,null,null);
    }
    mc_configured = true;
    if (mc_choice[2] == 1) { MiniCraftAI_Start(); }
    else { UIDisplayMessage(PlayerGroupAll(),c_messageAreaChat,StringToText("[MiniCraft] 기본 AI 활성화")); }
    TriggerDebugOutput(1,StringToText("MiniCraft options applied: "+IntToString(mc_mult)+"x, cap "+IntToString(200+100*mc_choice[3])),true);
}
bool MC_Timeout(bool testConds,bool runActions) {
    if (runActions && !mc_configured) { MC_Apply(); }
    return true;
}
bool MC_Click(bool testConds,bool runActions) {
    int c;
    int i = 0;
    int[6] max;
    if (!runActions || mc_configured || EventPlayer() != mc_host) { return true; }
    c = EventDialogControl();
    if (c == mc_start) { MC_Apply(); return true; }
    max[0]=1; max[1]=8; max[2]=2; max[3]=4; max[4]=10; max[5]=2;
    while (i < 6) {
        if (c == mc_buttons[i]) {
            mc_choice[i] = (mc_choice[i]+1) % max[i];
            DialogControlSetPropertyAsText(c,c_triggerControlPropertyText,PlayerGroupAll(),StringToText(MC_Value(i)));
        }
        i += 1;
    }
    return true;
}
bool MC_Show(bool testConds,bool runActions) {
    int p = 1;
    int i = 0;
    int label;
    string[6] names;
    if (!runActions || mc_configured || mc_dialog != -1) { return true; }
    while (p <= 15) {
        if (MC_Active(p) && PlayerType(p) == c_playerTypeUser) { mc_host = p; break; }
        p += 1;
    }
    MC_LoadFood();
    mc_choice[2] = 1;
    mc_choice[3] = 1;
    if (mc_host == 0) { MC_Apply(); return true; }
    UnitPauseAll(true);
    AITimePause(true);
    mc_dialog = DialogCreate(660,440,c_anchorCenter,0,0,true);
    names[0]="크래프트"; names[1]="생산 배수"; names[2]="AI"; names[3]="최대 인구"; names[4]="필드 자원"; names[5]="일꾼";
    while (i < 6) {
        label = DialogControlCreate(mc_dialog,c_triggerControlTypeLabel);
        DialogControlSetPosition(label,PlayerGroupAll(),c_anchorTopLeft,25,35+i*52);
        DialogControlSetSize(label,PlayerGroupAll(),170,42);
        DialogControlSetPropertyAsText(label,c_triggerControlPropertyText,PlayerGroupAll(),StringToText(names[i]));
        mc_buttons[i] = MC_Button(MC_Value(i),205,30+i*52,420);
        i += 1;
    }
    DialogControlSetEnabled(mc_buttons[0],PlayerGroupAll(),false);
    mc_start = MC_Button("게임 시작 (60초 후 자동 확정)",125,365,410);
    mc_menuTrigger = TriggerCreate("MC_Click");
    TriggerAddEventDialogControl(mc_menuTrigger,mc_host,c_invalidDialogControlId,c_triggerControlEventTypeClick);
    DialogSetVisible(mc_dialog,PlayerGroupSingle(mc_host),true);
    mc_timeout = TriggerCreate("MC_Timeout");
    TriggerAddEventTimeElapsed(mc_timeout,60.0,c_timeReal);
    return true;
}
void MiniCraftAI_Init() {
    trigger start;
    if (mc_initRequested) { return; }
    mc_initRequested = true;
    start = TriggerCreate("MC_Show");
    TriggerAddEventTimeElapsed(start,1.0,c_timeGame);
}
