    mc_foodId[43] = "QueenBurrowed"; mc_foodBase[43] = -1;
    mc_foodId[44] = "Mutalisk"; mc_foodBase[44] = -1;
    mc_foodId[45] = "Corruptor"; mc_foodBase[45] = -1;
    mc_foodId[46] = "BroodLord"; mc_foodBase[46] = -2;
    mc_foodId[47] = "Viper"; mc_foodBase[47] = -1.5;
    mc_foodId[48] = "Probe"; mc_foodBase[48] = -0.5;
    mc_foodId[49] = "Zealot"; mc_foodBase[49] = -1;
    mc_foodId[50] = "Stalker"; mc_foodBase[50] = -1;
    mc_foodId[51] = "Sentry"; mc_foodBase[51] = -1;
    mc_foodId[52] = "Adept"; mc_foodBase[52] = -1;
    mc_foodId[53] = "HighTemplar"; mc_foodBase[53] = -1;
    mc_foodId[54] = "DarkTemplar"; mc_foodBase[54] = -1;
    mc_foodId[55] = "Archon"; mc_foodBase[55] = -2;
    mc_foodId[56] = "Immortal"; mc_foodBase[56] = -2;
    mc_foodId[57] = "Colossus"; mc_foodBase[57] = -3;
    mc_foodId[58] = "Disruptor"; mc_foodBase[58] = -2;
    mc_foodId[59] = "Observer"; mc_foodBase[59] = -0.5;
    mc_foodId[60] = "WarpPrism"; mc_foodBase[60] = -1;
    mc_foodId[61] = "WarpPrismPhasing"; mc_foodBase[61] = -1;
    mc_foodId[62] = "Phoenix"; mc_foodBase[62] = -1;
