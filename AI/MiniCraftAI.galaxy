    mc_foodId[17] = "Liberator"; mc_foodBase[17] = -1.5;
    mc_foodId[18] = "LiberatorAG"; mc_foodBase[18] = -1.5;
    mc_foodId[19] = "Raven"; mc_foodBase[19] = -1;
    mc_foodId[20] = "Banshee"; mc_foodBase[20] = -1.5;
    mc_foodId[21] = "Battlecruiser"; mc_foodBase[21] = -3;
